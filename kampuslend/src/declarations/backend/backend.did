type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = 
 record {
   bankAccount: text;
   email: text;
   gpa: float64;
   isVerified: bool;
   ktm: text;
   name: text;
   role: text;
 };
type UserApprovalInfo = 
 record {
   "principal": principal;
   status: ApprovalStatus;
 };
type User = 
 record {
   bankAccount: text;
   email: text;
   gpa: float64;
   id: nat;
   isVerified: bool;
   ktm: text;
   name: text;
   "principal": principal;
   role: text;
 };
type Time = int;
type ScoringResult = 
 record {
   reason: text;
   recommendation: text;
   score: nat;
 };
type ScoringInput = 
 record {
   amount: nat;
   cleanHistory: bool;
   gpa: float64;
   purpose: text;
   tenor: nat;
 };
type Payment = 
 record {
   amount: nat;
   id: nat;
   loanId: nat;
   paymentDate: Time;
   remainingInstallment: float64;
   status: text;
   virtualAccount: text;
 };
type Loan = 
 record {
   aiReason: text;
   aiRecommendation: text;
   aiScore: nat;
   amount: nat;
   borrowerId: nat;
   borrowerName: text;
   id: nat;
   interestRate: float64;
   investorId: nat;
   major: text;
   monthlyInstallment: float64;
   purpose: text;
   startDate: Time;
   status: text;
   tenor: nat;
 };
type ApprovalStatus = 
 variant {
   approved;
   pending;
   rejected;
 };
service : {
  _initializeAccessControlWithSecret: (userSecret: text) -> ();
  addSeedData: () -> ();
  approveLoan: (loanId: nat, investorId: nat) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createLoan: (borrowerId: nat, borrowerName: text, major: text, amount: 
   nat, tenor: nat, monthlyInstallment: float64, purpose: text, aiScore: 
   nat, aiRecommendation: text, aiReason: text) -> (nat);
  createVirtualAccount: (loanId: nat) -> (text);
  getAllLoans: () -> (vec Loan) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getCicilanSisa: (loanId: nat) -> (float64) query;
  getCurrentUser: () -> (opt User) query;
  getLoan: (id: nat) -> (Loan) query;
  getLoansByBorrower: (borrowerId: nat) -> (vec Loan) query;
  getLoansByInvestor: (investorId: nat) -> (vec Loan) query;
  getPaymentsByLoan: (loanId: nat) -> (vec Payment) query;
  getUser: (id: nat) -> (opt User) query;
  getUserById: (id: nat) -> (opt User) query;
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  getUsersByRole: (role: text) -> (vec User) query;
  isCallerAdmin: () -> (bool) query;
  isCallerApproved: () -> (bool) query;
  listApprovals: () -> (vec UserApprovalInfo) query;
  recordPayment: (loanId: nat, amount: nat, remainingInstallment: float64,
   status: text, virtualAccount: text) -> (nat);
  registerUser: (name: text, email: text, role: text, ktm: text, bankAccount:
   text, gpa: float64) -> (nat);
  requestApproval: () -> ();
  saveCallerUserProfile: (profile: UserProfile) -> ();
  scoreApplicant: (input: ScoringInput) -> (ScoringResult) query;
  setApproval: (user: principal, status: ApprovalStatus) -> ();
  updateLoanStatus: (loanId: nat, status: text) -> ();
  verifyEmail: (userId: nat, _otp: text) -> (bool);
  verifyUser: (userId: nat) -> ();
}
